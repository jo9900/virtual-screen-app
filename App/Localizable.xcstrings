{
  "sourceLanguage": "en",
  "strings": {
    "%@ · Main Display": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · メインディスプレイ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 主显示器"
          }
        }
      }
    },
    "About Virtual Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual Screenについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Virtual Screen"
          }
        }
      }
    },
    "Could Not Create Virtual Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイを作成できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建虚拟屏幕"
          }
        }
      }
    },
    "Displays Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ設定…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器设置…"
          }
        }
      }
    },
    "Enable Virtual Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイを有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用虚拟屏幕"
          }
        }
      }
    },
    "HiDPI (Retina)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HiDPI（Retina）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HiDPI（Retina）"
          }
        }
      }
    },
    "Not Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        }
      }
    },
    "Quit Virtual Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual Screenを終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Virtual Screen"
          }
        }
      }
    },
    "Resolution": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像度"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨率"
          }
        }
      }
    },
    "Start Virtual Screen at login?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時にVirtual Screenを起動しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在登录时启动 Virtual Screen 吗？"
          }
        }
      }
    },
    "Start at Login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "Start at Login (Needs Approval)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動（承認が必要）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动（需要批准）"
          }
        }
      }
    },
    "Starting Virtual Screen…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイを起動しています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动虚拟屏幕…"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Virtual Screen Is Off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイはオフです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟屏幕已关闭"
          }
        }
      }
    },
    "Virtual Screen runs in the menu bar. Starting it at login brings the virtual screen back after every restart, which a Mac without a monitor needs for remote access.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual Screenはメニューバーで動作します。ログイン時に起動すると、再起動のたびに仮想ディスプレイが復元されます。モニターを接続していないMacをリモート操作するには、この設定が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual Screen 在菜单栏中运行。在登录时启动，每次重启后都会恢复虚拟屏幕。没有接显示器的 Mac 需要它才能远程访问。"
          }
        }
      }
    }
  },
  "version": "1.0"
}